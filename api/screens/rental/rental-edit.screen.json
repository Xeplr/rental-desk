                        "variant": "primary"
                    },
                    {
                        "id": "returned",
                        "ask": {
                            "note": "Condition on return",
                            "title": "Mark this rental as returned?"
                        },
                        "when": [
                            {
                                "op": "eq",
                                "field": "status",
                                "value": "out"
                            }
                        ],
                        "label": "Returned",
                        "action": "setRentalStatus",
                        "params": {
                            "status": "returned"
