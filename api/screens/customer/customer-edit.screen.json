            "type": "text",
            "props": {
                "name": "email",
                "label": "Email",
                "preset": "email",
                "required": true,
                "inputType": "email",
                "validation": {
                    "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$",
                    "maxLength": 254,
                    "patternMessage": "Enter an email address, like name@example.com"
                },
                "placeholder": "name@example.com"
            }
        },
        {
            "h": 0.08,
            "w": 0.44,
            "x": 0.04,
            "y": 0.36,
            "z": 4,
            "id": "phone",
            "type": "text",
            "props": {
                "name": "phone",
                "label": "Phone",
                "preset": "phone",
                "required": true,
                "inputType": "tel",
                "validation": {
                    "pattern": "^\\+?[0-9][0-9 ().\\-]{5,18}[0-9]$",
                    "maxLength": 20,
                    "patternMessage": "Enter a phone number — digits, spaces, + ( ) and - only"
                },
                "placeholder": "+1 555 010 9999"
            }
        },
